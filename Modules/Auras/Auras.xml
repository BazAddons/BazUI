<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
    <!-- The look of one aura icon: a rim, the icon inside it, the stack
         count and the time left. Square or round, which is a mask over
         the same geometry rather than a second template.
         Shared by the real buttons and the preview's stand-ins. -->
    <Button name="BazUIAuraVisualTemplate" virtual="true">
        <Size x="26" y="26"/>
        <Layers>
            <Layer level="BACKGROUND">
                <!-- The rim, and the button's whole box.
                     
                     It used to hang two pixels outside the button and wear
                     a rounded-square mask off one of the game's atlases.
                     Both cost more than they were worth: the mask insets
                     the art it covers, so a row set to no spacing still
                     showed a dark strip between every pair of icons - two
                     rims, side by side, in the gap the inset left - and a
                     row measured four pixels narrower than it looked,
                     which a row told to fill its host then got wrong.
                     
                     Square, and inside the box, so what a button occupies
                     is what you can see of it. Spacing is then the number
                     it says it is, and it is the same square border the
                     bars and panels wear. -->
                <Texture parentKey="Border" setAllPoints="true">
                    <Color r="0.08" g="0.08" b="0.10" a="1"/>
                </Texture>

                <!-- Rounded corners, when they are asked for.
                     
                     Declared here and attached to nothing: a MaskTexture
                     does nothing until a texture is told to wear it, so
                     these sit inert until Auras.ApplyButtonShape hands
                     them out, and the setting can be changed back without
                     rebuilding a single button.
                     
                     Two of them, one per texture, each anchored to what it
                     masks. A single button-sized mask would round the
                     border correctly and leave the icon - which sits a
                     pixel inside - with corners the mask never reached.
                     
                     Centred on what they mask and sized by
                     Auras.ApplyButtonShape, because the art needs scaling
                     up before its opaque part covers the whole rect - see
                     the note beside MASK_OPAQUE. Neither moves an anchor. That is what the square version of this
                     went wrong on: the rim used to hang two pixels outside
                     the button, so a row measured four pixels narrower
                     than it looked and one told to fill its host got it
                     wrong. Rounding is only what is drawn; the box a
                     button occupies is the same either way. -->
                <MaskTexture parentKey="RoundMaskBorder" atlas="UI-HUD-ActionBar-IconFrame-Mask"
                             hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </MaskTexture>
                <MaskTexture parentKey="RoundMaskIcon" atlas="UI-HUD-ActionBar-IconFrame-Mask"
                             hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.Icon"/>
                    </Anchors>
                </MaskTexture>
            </Layer>
            <Layer level="ARTWORK">
                <!-- Trimmed, because every icon in the game's art has a
                     dark border painted into it about a fifteenth of the
                     way in. Drawing the whole texture puts that border
                     inside our button on top of our own. -->
                <Texture parentKey="Icon">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="1" y="-1"/>
                        <Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
                    </Anchors>
                    <TexCoords left="0.07" right="0.93" top="0.07" bottom="0.93"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="Count" inherits="NumberFontNormalSmall" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="Duration" inherits="GameFontHighlightSmallOutline" justifyH="CENTER">
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Button>

    <!-- One real aura icon. BazUI's own header creates these and stamps
         index, filter or target-slot on each; BazUI.Auras.* only reads
         those and paints.

         This used to inherit SecureAuraButtonTemplate, which is declared
         inside Blizzard's SecureAuraHeader.xml - a file gated to the
         classic game type, and so absent on Forever. Inheriting a
         template that does not exist takes the whole button with it.
         That template is only SecureActionButtonTemplate plus the one
         attribute below, so it is cheaper to say so directly than to
         depend on a file that may or may not have loaded.

         type2 = cancelaura is what makes right-click cancel a buff.
         Cancelling is protected - CancelUnitBuff and
         C_UnitAuras.CancelAuraByInstanceID both are - so it can only
         happen through a secure button acting on a real click. It
         registers both press and release because the secure handler acts
         on one or the other depending on the "cast on key down" setting,
         and fires the cancel exactly once either way. -->
    <Button name="BazUIAuraButtonTemplate" inherits="SecureActionButtonTemplate, BazUIAuraVisualTemplate" registerForClicks="RightButtonDown, RightButtonUp" virtual="true">
        <Attributes>
            <Attribute name="type2" value="cancelaura"/>
        </Attributes>
        <Scripts>
            <OnLoad>BazUI.Auras.OnButtonLoad(self)</OnLoad>
            <OnAttributeChanged>BazUI.Auras.OnButtonAttributeChanged(self, name, value)</OnAttributeChanged>
            <OnShow>BazUI.Auras.OnButtonShow(self)</OnShow>
            <OnHide>BazUI.Auras.OnButtonHide(self)</OnHide>
            <OnEnter>BazUI.Auras.OnButtonEnter(self)</OnEnter>
            <OnLeave>BazUI.Auras.OnButtonLeave(self)</OnLeave>
        </Scripts>
    </Button>
</Ui>
