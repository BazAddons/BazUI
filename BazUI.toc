# Chat is switched off on the Forever beta.
#
# A chat replacement has to assign DEFAULT_CHAT_FRAME, and assigning a
# global Blizzard reads taints every call that reads it. Theirs reads it
# inside EnterEditMode, one line before their party frames compare a
# secret colour, so opening Edit Mode errors. There is no way to route
# their messaging to our window without that assignment.
#
# Commented out rather than left to the module switch, because that
# switch does not currently survive a reload - a separate bug, still
# open. Uncomment the block below to bring chat back.
# Modules\Chat\Core\Init.lua
# Modules\Chat\Core\Frames.lua
# Modules\Chat\Replica\HideDefault.lua
# Modules\Chat\Replica\Chat.xml
# Modules\Chat\Replica\Chrome.lua
# Modules\Chat\Replica\Tabs.lua
# Modules\Chat\Replica\AutoHide.lua
# Modules\Chat\Replica\Channels.lua
# Modules\Chat\Replica\Persistence.lua
# Modules\Chat\Replica\Timestamps.lua
# Modules\Chat\Replica\TimestampOverlay.lua
# Modules\Chat\Replica\ChannelNames.lua
# Modules\Chat\Replica\SettingsSpec.lua
# Modules\Chat\Replica\Window.lua
